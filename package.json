{
  "name": "cv-val",
  "private": true,
  "version": "0.0.1",
  "description": "Computer Vision Validation Tool",
  "author": "underhand-lab <skysea001010@gmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite dev --mode web",
    "dev:electron": "electron-vite dev --mode desktop",
    "build:web": "vite build --mode web",
    "build:electron": "vite build --mode desktop && electron-vite build --mode desktop",
    "dist": "electron-vite build --mode desktop && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron-vite preview",
    "prebuild": "electron-vite build"
  },
  "build": {
    "appId": "com.underland-lab.cvval",
    "productName": "CV-Val",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "out/**"
    ],
    "icon": "desktop-ico.png",
    "win": {
      "icon": "desktop-ico.png",
      "artifactName": "${productName}.${ext}"
    },
    "mac": {
      "artifactName": "${productName}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "cvp",
        "name": "Pose Data File",
        "role": "Editor"
      },
      {
        "ext": "cvbl",
        "name": "Track Ball Data File",
        "role": "Editor"
      },
      {
        "ext": "cvbt",
        "name": "Track Bat Data File",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/tasks-vision": "^0.10.33",
    "@shopify/react-native-skia": "^2.6.2",
    "@tensorflow/tfjs": "^4.22.0",
    "chart.js": "^4.5.1",
    "mediabunny": "^1.40.0",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.2",
    "react-markdown": "^10.1.0",
    "react-native": "^0.85.0",
    "react-native-web": "^0.21.2",
    "react-router-dom": "^7.13.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  }
}